# ==============================================
# TalentFlow AI - API Gateway
# Environment Configuration
# ==============================================

# ======================
# Application
# ======================
# Environment: development | production | test
NODE_ENV=development

# Server port
PORT=8080

# ======================
# Database
# ======================
DATABASE_URL="postgresql://postgres:1111@localhost:5432/talentflow_ai?schema=public"
DIRECT_URL="postgresql://postgres:1111@localhost:5432/talentflow_ai?schema=public"

# ======================
# Redis (Cache only)
# ======================
REDIS_URL="redis://localhost:6379"

# ======================
# RabbitMQ (Message Queue)
# ======================
RABBITMQ_URL=amqp://rabbitmq:rabbitmq@localhost:5672

# AMQP heartbeat interval (seconds)
RABBITMQ_HEARTBEAT_SEC=30

# Reconnect backoff settings (milliseconds)
RABBITMQ_RECONNECT_INITIAL_DELAY_MS=1000
RABBITMQ_RECONNECT_MAX_DELAY_MS=30000

# ======================
# JWT Authentication
# ======================
JWT_ACCESS_SECRET="dev-access-secret-key-min-16-characters"
JWT_REFRESH_SECRET="dev-refresh-secret-key-min-16-characters"
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ======================
# Cloudflare R2 Storage (Mocked for Dev)
# ======================
# S3-compatible endpoint (MinIO local / R2 custom endpoint)
R2_ENDPOINT=http://localhost:9000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=talentflow-cvs
R2_PUBLIC_URL=http://localhost:9000/talentflow-cvs

# ======================
# Rate Limiting
# ======================
RATE_LIMIT_TTL_SEC=60
RATE_LIMIT_MAX=100

# ======================
# Security & Performance
# ======================
BODY_LIMIT_MB=10
TIMEOUT_MS=15000
CORS_ORIGINS=http://localhost:3001,http://localhost:3000
SEED_DEFAULT_PASSWORD=SeedPassword123!

# ======================
# Observability (Optional)
# ======================
LOG_LEVEL=debug
ELK_HOST=http://localhost:9200
ELK_LOG_LEVEL=info
ELK_INDEX_PREFIX=talentflow-api
# ELK_USERNAME=elastic
# ELK_PASSWORD=changeme
QUEUE_METRICS_POLL_INTERVAL_MS=30000