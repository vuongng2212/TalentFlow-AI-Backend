generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  password            String
  role                Role                 @default(RECRUITER)
  fullName            String               @map("full_name")
  createdJobs         Job[]                @relation("JobCreator")
  interviews          Interview[]          @relation("InterviewInterviewer")
  subscriptions       UserSubscription[]
  paymentTransactions PaymentTransaction[]
  aiUsageRecords      AiUsageRecord[]      @relation("AiUsageActor")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")

  @@map("users")
}

model Job {
  id             String         @id @default(uuid())
  title          String
  description    String?
  requirements   Json?
  department     String?
  location       String?
  employmentType EmploymentType @default(FULL_TIME)
  salaryMin      Int?
  salaryMax      Int?
  status         JobStatus      @default(DRAFT)
  createdById    String         @map("created_by_id")
  createdBy      User           @relation("JobCreator", fields: [createdById], references: [id], onDelete: Cascade)
  applications   Application[]
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  @@index([createdById])
  @@index([status])
  @@map("jobs")
}

model SubscriptionPlan {
  id                  String                @id @default(uuid())
  code                SubscriptionPlanCode  @unique
  name                String
  scope               SubscriptionPlanScope
  billingPeriod       BillingPeriod         @map("billing_period")
  dailyAiRequestLimit Int                   @map("daily_ai_request_limit")
  trialAiRequestLimit Int?                  @map("trial_ai_request_limit")
  isPaid              Boolean               @default(false) @map("is_paid")
  priceAmount         Int                   @default(0) @map("price_amount")
  currency            String                @default("VND")
  checkoutEligible    Boolean               @default(false) @map("checkout_eligible")
  canScoreCv          Boolean               @default(true) @map("can_score_cv")
  canAnalyzeCvFit     Boolean               @default(false) @map("can_analyze_cv_fit")
  isActive            Boolean               @default(true) @map("is_active")
  userSubscriptions   UserSubscription[]
  paymentTransactions PaymentTransaction[]
  aiUsageRecords      AiUsageRecord[]
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  @@map("subscription_plans")
}

model UserSubscription {
  id                   String              @id @default(uuid())
  userId               String              @map("user_id")
  planId               String              @map("plan_id")
  status               SubscriptionStatus  @default(ACTIVE)
  periodStart          DateTime            @default(now()) @map("period_start")
  periodEnd            DateTime?           @map("period_end")
  paymentTransactionId String?             @unique @map("payment_transaction_id")
  businessWorkspaceId  String?             @map("business_workspace_id")
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 SubscriptionPlan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([planId])
  @@map("user_subscriptions")
}

model AiUsageRecord {
  id          String             @id @default(uuid())
  actorId     String             @map("actor_id")
  contextType AiUsageContextType @map("context_type")
  planId      String             @map("plan_id")
  action      AiUsageAction
  usageDate   DateTime           @map("usage_date") @db.Date
  count       Int                @default(1)
  decision    AiUsageDecision    @default(ALLOWED)
  denyReason  String?            @map("deny_reason")
  actor       User               @relation("AiUsageActor", fields: [actorId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdAt   DateTime           @default(now()) @map("created_at")

  @@index([actorId, contextType, usageDate])
  @@index([planId])
  @@map("ai_usage_records")
}

model PaymentTransaction {
  id                    String                   @id @default(uuid())
  userId                String                   @map("user_id")
  planId                String                   @map("plan_id")
  provider              PaymentProvider          @default(MOMO)
  providerRequestId     String                   @unique @map("provider_request_id")
  providerOrderId       String                   @unique @map("provider_order_id")
  providerTransactionId String?                  @map("provider_transaction_id")
  expectedAmount        Int                      @map("expected_amount")
  currency              String                   @default("VND")
  status                PaymentTransactionStatus @default(PENDING)
  checkoutUrl           String?                  @map("checkout_url")
  deeplink              String?
  qrCodeUrl             String?                  @map("qr_code_url")
  rawProviderRequest    Json?                    @map("raw_provider_request")
  rawProviderResponse   Json?                    @map("raw_provider_response")
  rejectionReason       String?                  @map("rejection_reason")
  confirmedAt           DateTime?                @map("confirmed_at")
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                  SubscriptionPlan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  confirmations         PaymentConfirmation[]
  activatedSubscription UserSubscription?
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([planId])
  @@index([status])
  @@map("payment_transactions")
}

model PaymentConfirmation {
  id                   String                    @id @default(uuid())
  paymentTransactionId String                    @map("payment_transaction_id")
  source               PaymentConfirmationSource
  resultCode           Int?                      @map("result_code")
  message              String?
  signatureValid       Boolean                   @default(false) @map("signature_valid")
  accepted             Boolean                   @default(false)
  rejectionReason      String?                   @map("rejection_reason")
  rawPayload           Json?                     @map("raw_payload")
  paymentTransaction   PaymentTransaction        @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)
  receivedAt           DateTime                  @default(now()) @map("received_at")

  @@index([paymentTransactionId])
  @@index([accepted])
  @@map("payment_confirmations")
}

model Candidate {
  id          String  @id @default(uuid())
  email       String  @unique
  fullName    String  @map("full_name")
  phone       String?
  linkedinUrl String? @map("linkedin_url")
  resumeUrl   String? @map("resume_url")
  resumeText  String? @map("resume_text") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  applications Application[]

  @@index([email])
  @@index([fullName])
  @@map("candidates")
}

model Application {
  id          String            @id @default(uuid())
  jobId       String            @map("job_id")
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId String            @map("candidate_id")
  candidate   Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  stage       ApplicationStage  @default(APPLIED)
  status      ApplicationStatus @default(SUBMITTED)
  cvFileKey   String?           @map("cv_file_key")
  cvFileUrl   String?           @map("cv_file_url")
  coverLetter String?           @map("cover_letter")
  notes       String?
  appliedAt   DateTime          @default(now()) @map("applied_at")
  reviewedAt  DateTime?         @map("reviewed_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")

  interviews Interview[]

  @@unique([jobId, candidateId])
  @@index([jobId])
  @@index([candidateId])
  @@index([status])
  @@map("applications")
}

model Interview {
  id            String          @id @default(uuid())
  applicationId String          @map("application_id")
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime        @map("scheduled_at")
  duration      Int             @default(60) // duration in minutes
  type          InterviewType   @default(VIDEO)
  location      String? // video link, room, or address
  notes         String?
  status        InterviewStatus @default(SCHEDULED)
  interviewerId String?         @map("interviewer_id")
  interviewer   User?           @relation("InterviewInterviewer", fields: [interviewerId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([applicationId])
  @@index([scheduledAt])
  @@index([status])
  @@index([interviewerId])
  @@map("interviews")
}

enum Role {
  ADMIN
  RECRUITER
  INTERVIEWER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum ApplicationStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  SHORTLISTED
  INTERVIEW_SCHEDULED
  INTERVIEWED
  OFFERED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum InterviewType {
  PHONE
  VIDEO
  IN_PERSON
  PANEL
  TECHNICAL
}

enum InterviewStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SubscriptionPlanCode {
  FREE
  PLUS
  BUSINESS
}

enum SubscriptionPlanScope {
  PERSONAL
  WORKSPACE
}

enum BillingPeriod {
  NONE
  MONTHLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum PaymentProvider {
  MOMO
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  REJECTED
}

enum PaymentConfirmationSource {
  MOMO_IPN
  INTERNAL_OPERATOR
  INTERNAL_REPLAY
}

enum AiUsageContextType {
  PERSONAL
}

enum AiUsageAction {
  CV_SCORE
  CV_FIT_ANALYSIS
}

enum AiUsageDecision {
  ALLOWED
  DENIED
}
