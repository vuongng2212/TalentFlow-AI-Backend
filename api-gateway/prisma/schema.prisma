generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                          String                @id @default(uuid())
  email                       String                @unique
  password                    String
  role                        Role                  @default(RECRUITER)
  fullName                    String                @map("full_name")
  activeWorkspaceId           String?               @map("active_workspace_id")
  activeWorkspace             Workspace?            @relation("UserActiveWorkspace", fields: [activeWorkspaceId], references: [id], onDelete: SetNull)
  createdJobs                 Job[]                 @relation("JobCreator")
  interviews                  Interview[]           @relation("InterviewInterviewer")
  workspaceMembers            WorkspaceMember[]
  invitedWorkspaceMembers     WorkspaceMember[]     @relation("WorkspaceInvitation")
  createdWorkspaces           Workspace[]           @relation("WorkspaceCreator")
  workspaceInvitationsCreated WorkspaceInvitation[] @relation("WorkspaceInvitationCreator")
  requestedPayments           Payment[]             @relation("PaymentRequester")
  createdAt                   DateTime              @default(now()) @map("created_at")
  updatedAt                   DateTime              @updatedAt @map("updated_at")
  deletedAt                   DateTime?             @map("deleted_at")

  @@index([activeWorkspaceId])
  @@map("users")
}

model Job {
  id             String         @id @default(uuid())
  title          String
  description    String?
  requirements   Json?
  department     String?
  location       String?
  employmentType EmploymentType @default(FULL_TIME)
  salaryMin      Int?
  salaryMax      Int?
  status         JobStatus      @default(DRAFT)
  workspaceId    String         @map("workspace_id")
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById    String         @map("created_by_id")
  createdBy      User           @relation("JobCreator", fields: [createdById], references: [id], onDelete: Cascade)
  applications   Application[]
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  @@index([createdById])
  @@index([status])
  @@index([workspaceId])
  @@map("jobs")
}

model Workspace {
  id             String                @id @default(uuid())
  name           String
  isBusiness     Boolean               @default(false) @map("is_business")
  createdById    String?               @map("created_by_id")
  createdBy      User?                 @relation("WorkspaceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members        WorkspaceMember[]
  activeUsers    User[]                @relation("UserActiveWorkspace")
  jobs           Job[]
  candidates     Candidate[]
  applications   Application[]
  interviews     Interview[]
  emailTemplates EmailTemplate[]
  invitations    WorkspaceInvitation[]
  subscription   Subscription?
  payments       Payment[]
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  @@map("workspaces")
}

model Plan {
  id              String         @id @default(uuid())
  code            PlanCode       @unique
  name            String
  displayOrder    Int            @unique @map("display_order")
  isActive        Boolean        @default(true) @map("is_active")
  enablesBusiness Boolean        @default(false) @map("enables_business")
  subscriptions   Subscription[]
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@map("plans")
}

model Subscription {
  id          String             @id @default(uuid())
  workspaceId String             @unique @map("workspace_id")
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planId      String             @map("plan_id")
  plan        Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status      SubscriptionStatus @default(ACTIVE)
  startedAt   DateTime           @default(now()) @map("started_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

model Payment {
  id                            String                      @id @default(uuid())
  reference                     String                      @unique
  workspaceId                   String                      @map("workspace_id")
  workspace                     Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requesterId                   String                      @map("requester_id")
  requester                     User                        @relation("PaymentRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  idempotencyOperation          PaymentIdempotencyOperation @map("idempotency_operation")
  idempotencyKeyDigest          String                      @map("idempotency_key_digest")
  idempotencyRequestFingerprint String                      @map("idempotency_request_fingerprint")
  provider                      PaymentProvider             @default(MOMO)
  momoOrderId                   String                      @unique @map("momo_order_id")
  momoRequestId                 String                      @unique @map("momo_request_id")
  amountVnd                     Int                         @map("amount_vnd")
  currency                      String                      @default("VND")
  chargeSnapshot                Json                        @map("charge_snapshot")
  status                        PaymentStatus               @default(PENDING)
  checkoutStatus                PaymentCheckoutStatus       @default(NOT_REQUESTED) @map("checkout_status")
  checkoutUrl                   String?                     @map("checkout_url")
  momoTransactionId             BigInt?                     @map("momo_transaction_id")
  providerResultCode            Int?                        @map("provider_result_code")
  expiresAt                     DateTime?                   @map("expires_at")
  succeededAt                   DateTime?                   @map("succeeded_at")
  failedAt                      DateTime?                   @map("failed_at")
  cancelledAt                   DateTime?                   @map("cancelled_at")
  outcomeRecordedAt             DateTime?                   @map("outcome_recorded_at")
  createdAt                     DateTime                    @default(now()) @map("created_at")
  updatedAt                     DateTime                    @updatedAt @map("updated_at")
  providerResults               PaymentProviderResult[]
  processingRecords             PaymentProcessingRecord[]
  invoice                       Invoice?
  auditEvents                   PaymentAuditEvent[]

  @@unique([requesterId, workspaceId, idempotencyOperation, idempotencyKeyDigest], map: "payments_idempotency_key")
  @@index([workspaceId, createdAt])
  @@index([workspaceId, status, updatedAt])
  @@index([status, checkoutStatus, expiresAt])
  @@index([momoTransactionId])
  @@map("payments")
}

model PaymentProviderResult {
  id                String                   @id @default(uuid())
  semanticKey       String                   @unique @map("semantic_key")
  paymentId         String?                  @map("payment_id")
  payment           Payment?                 @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  provider          PaymentProvider          @default(MOMO)
  partnerCode       String                   @map("partner_code")
  orderId           String                   @map("order_id")
  requestId         String                   @map("request_id")
  momoTransactionId BigInt?                  @map("momo_transaction_id")
  resultCode        Int                      @map("result_code")
  claimedOutcome    String                   @map("claimed_outcome")
  disposition       PaymentResultDisposition
  reasonCode        String?                  @map("reason_code")
  responseTime      DateTime?                @map("response_time")
  receivedAt        DateTime                 @default(now()) @map("received_at")
  lastReceivedAt    DateTime                 @default(now()) @map("last_received_at")
  duplicateCount    Int                      @default(0) @map("duplicate_count")
  safePayload       Json?                    @map("safe_payload")

  @@index([paymentId])
  @@index([partnerCode, orderId, requestId])
  @@index([momoTransactionId])
  @@map("payment_provider_results")
}

model PaymentProcessingRecord {
  id              String            @id @default(uuid())
  paymentId       String            @map("payment_id")
  payment         Payment           @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  workKey         String            @unique @map("work_key")
  kind            PaymentWorkKind
  status          PaymentWorkStatus @default(PENDING)
  attemptCount    Int               @default(0) @map("attempt_count")
  availableAt     DateTime          @default(now()) @map("available_at")
  leaseOwner      String?           @map("lease_owner")
  leaseExpiresAt  DateTime?         @map("lease_expires_at")
  lastAttemptAt   DateTime?         @map("last_attempt_at")
  completedAt     DateTime?         @map("completed_at")
  safeFailureCode String?           @map("safe_failure_code")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([status, availableAt, leaseExpiresAt])
  @@index([paymentId])
  @@map("payment_processing_records")
}

model Invoice {
  id                String                @id @default(uuid())
  invoiceReference  String                @unique @map("invoice_reference")
  paymentId         String                @unique @map("payment_id")
  payment           Payment               @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  issuedAt          DateTime              @default(now()) @map("issued_at")
  issuerSnapshot    Json                  @map("issuer_snapshot")
  payerSnapshot     Json                  @map("payer_snapshot")
  lineItemsSnapshot Json                  @map("line_items_snapshot")
  subtotalVnd       Int                   @map("subtotal_vnd")
  taxVnd            Int                   @map("tax_vnd")
  totalVnd          Int                   @map("total_vnd")
  currency          String                @default("VND")
  documentStatus    InvoiceDocumentStatus @default(PENDING_RENDER) @map("document_status")
  storageBucket     String?               @map("storage_bucket")
  storageKey        String?               @map("storage_key")
  contentSha256     String?               @map("content_sha256")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  auditEvents       PaymentAuditEvent[]

  @@map("invoices")
}

model PaymentAuditEvent {
  id            String                @id @default(uuid())
  paymentId     String                @map("payment_id")
  payment       Payment               @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId     String?               @map("invoice_id")
  invoice       Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  action        PaymentAuditAction
  previousState PaymentStatus?        @map("previous_state")
  newState      PaymentStatus?        @map("new_state")
  actorKind     PaymentAuditActorKind @map("actor_kind")
  correlationId String?               @map("correlation_id")
  reasonCode    String?               @map("reason_code")
  occurredAt    DateTime              @default(now()) @map("occurred_at")

  @@index([paymentId, occurredAt])
  @@index([invoiceId])
  @@map("payment_audit_events")
}

model WorkspaceMember {
  id          String                @id @default(uuid())
  workspaceId String                @map("workspace_id")
  userId      String                @map("user_id")
  role        WorkspaceMemberRole   @default(RECRUITER)
  status      WorkspaceMemberStatus @default(ACTIVE)
  invitedById String?               @map("invited_by_id")
  invitedBy   User?                 @relation("WorkspaceInvitation", fields: [invitedById], references: [id], onDelete: SetNull)
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  @@unique([workspaceId, userId])
  @@index([workspaceId, status])
  @@index([userId, status])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          String              @id @default(uuid())
  email       String
  workspaceId String              @map("workspace_id")
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  token       String              @unique
  role        WorkspaceMemberRole @default(RECRUITER)
  invitedById String              @map("invited_by_id")
  invitedBy   User                @relation("WorkspaceInvitationCreator", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime            @map("expires_at")
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([email])
  @@index([workspaceId])
  @@map("workspace_invitations")
}

model Candidate {
  id          String    @id @default(uuid())
  email       String
  fullName    String    @map("full_name")
  phone       String?
  linkedinUrl String?   @map("linkedin_url")
  resumeUrl   String?   @map("resume_url")
  resumeText  String?   @map("resume_text") @db.Text
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  applications Application[]

  @@unique([workspaceId, email])
  @@index([email])
  @@index([fullName])
  @@index([workspaceId])
  @@map("candidates")
}

model Application {
  id                String            @id @default(uuid())
  jobId             String            @map("job_id")
  job               Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId       String            @map("candidate_id")
  candidate         Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  workspaceId       String            @map("workspace_id")
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stage             ApplicationStage  @default(APPLIED)
  status            ApplicationStatus @default(SUBMITTED)
  cvFileKey         String?           @map("cv_file_key")
  cvFileUrl         String?           @map("cv_file_url")
  coverLetter       String?           @map("cover_letter")
  externalMessageId String?           @map("external_message_id")
  notes             String?
  cvParsingStatus   CvParsingStatus   @default(PENDING) @map("cv_parsing_status")
  aiScore           Int?              @map("ai_score")
  scoringReasoning  String?           @map("scoring_reasoning") @db.Text
  parsedData        Json?             @map("parsed_data")
  appliedAt         DateTime          @default(now()) @map("applied_at")
  reviewedAt        DateTime?         @map("reviewed_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  deletedAt         DateTime?         @map("deleted_at")

  interviews Interview[]

  @@unique([jobId, candidateId])
  @@index([jobId])
  @@index([candidateId])
  @@index([status])
  @@index([workspaceId])
  @@map("applications")
}

model Interview {
  id            String          @id @default(uuid())
  applicationId String          @map("application_id")
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  workspaceId   String          @map("workspace_id")
  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime        @map("scheduled_at")
  duration      Int             @default(60) // duration in minutes
  type          InterviewType   @default(VIDEO)
  location      String? // video link, room, or address
  notes         String?
  status        InterviewStatus @default(SCHEDULED)
  interviewerId String?         @map("interviewer_id")
  interviewer   User?           @relation("InterviewInterviewer", fields: [interviewerId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([applicationId])
  @@index([scheduledAt])
  @@index([status])
  @@index([interviewerId])
  @@index([workspaceId])
  @@map("interviews")
}

model EmailTemplate {
  id          String    @id @default(uuid())
  name        String
  subject     String
  body        String
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("email_templates")
}

enum Role {
  ADMIN
  RECRUITER
  INTERVIEWER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum ApplicationStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  SHORTLISTED
  INTERVIEW_SCHEDULED
  INTERVIEWED
  OFFERED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum InterviewType {
  PHONE
  VIDEO
  IN_PERSON
  PANEL
  TECHNICAL
}

enum InterviewStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum WorkspaceMemberRole {
  OWNER
  ADMIN
  RECRUITER
  VIEWER
}

enum WorkspaceMemberStatus {
  ACTIVE
  INVITED
  REMOVED
  EXPIRED
}

enum PlanCode {
  FREE
  PLUS
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE

  @@map("WorkspaceSubscriptionStatus")
}

enum PaymentProvider {
  MOMO
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
  REJECTED
}

enum PaymentCheckoutStatus {
  NOT_REQUESTED
  REQUESTING
  READY
  UNKNOWN
  UNAVAILABLE
}

enum PaymentIdempotencyOperation {
  INITIATE_MOMO_CHECKOUT
}

enum PaymentResultDisposition {
  VERIFIED
  REJECTED
  DUPLICATE
  CONFLICT_IGNORED
}

enum PaymentWorkKind {
  CREATE_CHECKOUT
  RECONCILE_MOMO
  APPLY_SUCCESS
  APPLY_FAILURE
  ISSUE_INVOICE
  RENDER_INVOICE
}

enum PaymentWorkStatus {
  PENDING
  LEASED
  COMPLETED
  RETRYABLE
  MANUAL_REVIEW
}

enum InvoiceDocumentStatus {
  PENDING_RENDER
  AVAILABLE
  RETRYABLE
}

enum PaymentAuditAction {
  PAYMENT_CREATED
  IDEMPOTENCY_REPLAYED
  CHECKOUT_READY
  CHECKOUT_UNKNOWN
  PROVIDER_RESULT_VERIFIED
  PROVIDER_RESULT_REJECTED
  PROVIDER_RESULT_DUPLICATE
  PROVIDER_RESULT_CONFLICT
  STATE_CHANGED
  WORK_RETRIED
  OUTCOME_RECORDED
  INVOICE_ISSUED
  INVOICE_RENDERED
  INVOICE_RENDER_FAILED
  RECONCILIATION_COMPLETED
}

enum PaymentAuditActorKind {
  USER
  MOMO
  SCHEDULER
  SYSTEM
}

enum CvParsingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
