# Application
NODE_ENV=development
PORT=5000
APP_NAME=notification-service
APP_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_ACCESS_SECRET=dev-access-secret-key-min-16-characters
JWT_EXPIRES_IN=1d

# Database
DATABASE_URL=postgresql://postgres:123@localhost:5433/talentflow_dev?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://rabbitmq:rabbitmq@localhost:5672
RABBITMQ_QUEUE=notification_queue
RABBITMQ_EXCHANGE=talentflow.events
RABBITMQ_PREFETCH_COUNT=10

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM="TalentFlow <noreply@talentflow.local>"

# WebSocket
WS_CORS_ORIGIN=http://localhost:3000
