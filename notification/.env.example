# Application
NODE_ENV=development
PORT=3001
APP_NAME=notification-service
APP_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=1d
JWT_ISSUER=talentflow-api-gateway
JWT_AUDIENCE=talentflow-notification-service

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talentflow_notification?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=notification_queue
RABBITMQ_EXCHANGE=talentflow.events
RABBITMQ_PREFETCH_COUNT=10

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM="TalentFlow <noreply@talentflow.local>"

# WebSocket
WS_CORS_ORIGIN=http://localhost:3000
