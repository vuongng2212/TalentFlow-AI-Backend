NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/talentflow_notification?schema=public
RABBITMQ_URL=amqp://rabbitmq:rabbitmq@localhost:5672
RABBITMQ_HEARTBEAT_SEC=30
RABBITMQ_RECONNECT_INITIAL_DELAY_MS=1000
RABBITMQ_RECONNECT_MAX_DELAY_MS=30000
JWT_ACCESS_SECRET=change-me-notification-access-secret
JWT_ISSUER=talentflow-api-gateway
JWT_AUDIENCE=talentflow-notification
RATE_LIMIT_TTL_SEC=60
RATE_LIMIT_MAX=100
BODY_LIMIT_MB=2
TIMEOUT_MS=15000
CORS_ORIGINS=http://localhost:3001
SWAGGER_ENABLED=true
